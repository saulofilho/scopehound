# Copie para deploy/.env. Não faça commit do .env.
POSTGRES_PASSWORD=troque-isto
# gere: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SCOPEHOUND_SECRET_KEY=
# OIDC do seu provedor (Keycloak, Okta, Google Workspace...)
SCOPEHOUND_OIDC_ISSUER=https://seu-provedor/realms/scopehound
SCOPEHOUND_OIDC_AUDIENCE=scopehound
SCOPEHOUND_OIDC_JWKS_URL=https://seu-provedor/realms/scopehound/protocol/openid-connect/certs
# LLM (recomendado local no servidor, p/ dados sensíveis)
SCOPEHOUND_LLM_BASE_URL=http://ollama:11434/v1
SCOPEHOUND_LLM_MODEL=qwen3:8b
# URL externa pela qual um alvo alcança o listener OOB
SCOPEHOUND_OOB_BASE_URL=https://oob.seu-dominio
