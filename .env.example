# Copie para .env e ajuste. Nunca faça commit do .env.

# Modo: local (127.0.0.1, SQLite) ou server
SCOPEHOUND_MODE=local
# Idioma / Language: pt ou/or en
SCOPEHOUND_LANGUAGE=pt

# LLM padrão (cada projeto pode usar a própria chave: scopehound project llm <projeto> --api-key)
# Gemini (free tier, só para alvos de laboratório):
SCOPEHOUND_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SCOPEHOUND_LLM_MODEL=gemini-2.5-flash   # confira o nome atual no Google AI Studio
SCOPEHOUND_LLM_API_KEY=
# Ollama (local, para dados sensíveis):
# SCOPEHOUND_LLM_BASE_URL=http://localhost:11434/v1
# SCOPEHOUND_LLM_MODEL=qwen3:8b
# Groq / OpenRouter: use a URL /v1 compatível com OpenAI do provedor.

# Orçamento padrão por tarefa
SCOPEHOUND_TASK_MAX_STEPS=30
SCOPEHOUND_TASK_MAX_REQUESTS=200
